{
  "name": "micro-framework-example",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:main-app\" \"npm run start:react-app\" \"npm run start:vue-app\" \"npm run start:micro-framework\"",
    "start:main-app": "npm run start --workspace=main-app",
    "start:react-app": "npm run start --workspace=react-app",
    "start:vue-app": "npm run start --workspace=vue-app",
    "start:micro-framework": "npm run start --workspace=micro-framework",
    "build": "npm run build --workspace=micro-framework"
  },
  "engines": {
    "node": ">=16"
  },
  "engineStrict": true,
  "repository": "https://github.com/ziyi2/micro-framework.git",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}